<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Adobe Fresco</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #1e1e1e;
            color: #e0e0e0;
            overflow: hidden;
            height: 100vh;
            user-select: none;
        }
        
        .app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
        }
        
        .top-toolbar {
            background: #252525;
            border-bottom: 1px solid #3a3a3a;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            min-height: 60px;
        }
        
        .toolbar-group {
            display: flex;
            align-items: center;
            gap: 8px;
            border-right: 1px solid #3a3a3a;
            padding-right: 16px;
        }
        
        .toolbar-group:last-child {
            border-right: none;
        }
        
        .main-content {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        .left-sidebar {
            background: #2a2a2a;
            border-right: 1px solid #3a3a3a;
            padding: 12px;
            width: 70px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
        }
        
        .tool-button {
            width: 50px;
            height: 50px;
            background: #353535;
            border: 2px solid transparent;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
            padding: 0;
        }
        
        .tool-button:hover {
            background: #404040;
        }
        
        .tool-button.active {
            background: #4a7eff;
            border-color: #6a9eff;
        }
        
        .tool-button svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }
        
        .canvas-area {
            flex: 1;
            background: #2a2a2a;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }
        
        .canvas-wrapper {
            position: relative;
            cursor: crosshair;
        }
        
        .canvas-wrapper.pan-cursor {
            cursor: grab;
        }
        
        .canvas-wrapper.pan-cursor.grabbing {
            cursor: grabbing;
        }
        
        .artboard {
            position: absolute;
            background: white;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }
        
        canvas {
            position: absolute;
            top: 0;
            left: 0;
            display: block;
        }
        
        .right-sidebar {
            background: #2a2a2a;
            border-left: 1px solid #3a3a3a;
            width: 220px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .layers-header {
            padding: 12px;
            border-bottom: 1px solid #3a3a3a;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .layers-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }
        
        .layer-item {
            background: #353535;
            border: 2px solid transparent;
            border-radius: 4px;
            padding: 8px;
            margin-bottom: 6px;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
        }
        
        .layer-item:hover {
            background: #404040;
        }
        
        .layer-item.active {
            background: #4a7eff;
            border-color: #6a9eff;
        }
        
        .layer-visibility {
            width: 20px;
            height: 20px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: inherit;
        }
        
        .layer-name {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 11px;
        }
        
        .layer-name-input {
            background: #2a2a2a;
            border: 1px solid #4a7eff;
            color: inherit;
            padding: 2px 4px;
            border-radius: 2px;
            font-size: 11px;
            font-family: inherit;
        }
        
        .layer-controls {
            display: flex;
            gap: 4px;
            padding: 8px;
            border-top: 1px solid #3a3a3a;
        }
        
        .icon-btn {
            flex: 1;
            height: 28px;
            background: #353535;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            color: inherit;
            font-size: 11px;
            transition: all 0.15s;
        }
        
        .icon-btn:hover {
            background: #404040;
        }
        
        .status-bar {
            background: #252525;
            border-top: 1px solid #3a3a3a;
            padding: 8px 16px;
            font-size: 11px;
            color: #888;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        label {
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        input[type="range"] {
            width: 100px;
            height: 4px;
            cursor: pointer;
        }
        
        input[type="color"] {
            width: 40px;
            height: 32px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        
        input[type="text"],
        input[type="number"] {
            background: #353535;
            border: 1px solid #3a3a3a;
            color: inherit;
            padding: 6px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-family: monospace;
        }
        
        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: #4a7eff;
        }
        
        .brush-preview {
            width: 80px;
            height: 80px;
            background: #353535;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        
        .brush-preview-canvas {
            display: block;
        }
        
        button {
            background: #353535;
            color: inherit;
            border: 1px solid #3a3a3a;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            transition: all 0.15s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        button:hover:not(:disabled) {
            background: #404040;
            border-color: #4a7eff;
        }
        
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        @media (max-width: 1024px) {
            .left-sidebar {
                width: 60px;
            }
            
            .right-sidebar {
                width: 180px;
            }
            
            .toolbar-group {
                padding-right: 8px;
            }
        }
        
        @media (max-width: 768px) {
            .left-sidebar {
                display: none;
            }
            
            .right-sidebar {
                display: none;
            }
            
            .top-toolbar {
                flex-direction: column;
                gap: 8px;
                min-height: auto;
            }
            
            .toolbar-group {
                border-right: none;
                width: 100%;
                padding-right: 0;
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="top-toolbar">
            <div class="toolbar-group">
                <button id="undoBtn" title="Undo (Ctrl+Z)">↶ Undo</button>
                <button id="redoBtn" title="Redo (Ctrl+Shift+Z)">↷ Redo</button>
            </div>
            
            <div class="toolbar-group">
                <label>
                    Size
                    <input type="range" id="brushSize" min="1" max="100" value="8">
                    <span id="sizeDisplay">8px</span>
                </label>
            </div>
            
            <div class="toolbar-group">
                <label>
                    Opacity
                    <input type="range" id="opacity" min="1" max="100" value="100">
                    <span id="opacityDisplay">100%</span>
                </label>
            </div>
            
            <div class="toolbar-group">
                <label>
                    Color
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="color" id="colorPicker" value="#000000">
                        <input type="text" id="hexInput" value="#000000" maxlength="7" style="width: 60px;">
                    </div>
                </label>
            </div>
            
            <div class="toolbar-group">
                <label>
                    Zoom
                    <div style="display: flex; gap: 4px;">
                        <button id="zoomIn">+</button>
                        <button id="zoomFit">Fit</button>
                        <button id="zoomOut">−</button>
                        <span id="zoomDisplay">100%</span>
                    </div>
                </label>
            </div>
            
            <div class="toolbar-group">
                <button id="exportBtn">⬇ Export PNG</button>
                <button id="clearBtn">🗑 Clear</button>
            </div>
        </div>
        
        <div class="main-content">
            <div class="left-sidebar">
                <button class="tool-button active" data-tool="brush" title="Brush (B)">
                    <svg viewBox="0 0 24 24"><circle cx="6" cy="18" r="2"/><path d="M18 6l-2-2-8 8v2h2l8-8z"/></svg>
                </button>
                <button class="tool-button" data-tool="watercolor" title="Watercolor">
                    <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3" opacity="0.8"/><circle cx="14" cy="10" r="2.5" opacity="0.6"/><circle cx="10" cy="14" r="2" opacity="0.7"/></svg>
                </button>
                <button class="tool-button" data-tool="smooth" title="Smooth Brush">
                    <svg viewBox="0 0 24 24"><path d="M4 18c3-2 8-4 12-4s6 2 6 4M4 14c4-2 9-3 12-3s5 1 5 3"/></svg>
                </button>
                <button class="tool-button" data-tool="eraser" title="Eraser (E)">
                    <svg viewBox="0 0 24 24"><path d="M19 6h-8l-6 6 8 8h6c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>
                </button>
                <button class="tool-button" data-tool="eyedropper" title="Eyedropper (I)">
                    <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 8.48 4 5.57 6.36 5.13 9.35c-2.86.6-5.13 3.07-5.13 6.07 0 3.54 2.88 6.42 6.42 6.42h11c2.73 0 4.95-2.22 4.95-4.95 0-2.58-2.05-4.68-4.62-4.85z"/></svg>
                </button>
                <button class="tool-button" data-tool="bucket" title="Paint Bucket (G)">
                    <svg viewBox="0 0 24 24"><path d="M17.75 7L14 3.25l-10 10V17h3.75L17.75 7zm2.96-2.96c.39-.39.39-1.02 0-1.41L18.37.29c-.39-.39-1.02-.39-1.41 0L15 2.
